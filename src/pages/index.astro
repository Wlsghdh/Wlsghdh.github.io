---
/**
 * 홈 — 섹션 순서만 정한다. 내용은 src/data/profile.json, src/data/log.json.
 * (skills 데이터는 profile.json 에 남아 있지만 화면에서는 뺐다)
 * (Research Log 섹션은 2026-11-17 사용자 요청으로 화면에서 뺐다. log.json 과 ResearchLog.astro 는 남아 있다)
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import DatedList from '../components/DatedList.astro';
import Publications from '../components/Publications.astro';
import Contact from '../components/Contact.astro';
import { profile } from '../lib/data';

const news = profile.news.slice(0, 8).map((n: { date: string; text: string; link?: string }) => ({
  date: n.date,
  title: n.text,
  href: n.link,
}));
// 설명(detail)은 2026-11-23 사용자 요청으로 화면에서 빼고 키워드 하나만 보인다. detail 데이터는 남아 있다
const experience = profile.experience.map((e) => ({ date: e.period, title: e.title, sub: e.org, keyword: e.keyword, logo: e.logo }));
const education = profile.education.map((e) => ({ date: e.period, title: e.school, sub: e.detail, logo: e.logo }));
const awards = profile.awards.map((a) => ({ date: a.date, title: a.title, sub: a.org, href: a.image || undefined }));
const certificates = profile.certificates.map((c) => ({
  date: c.date,
  title: c.title,
  sub: c.org,
  href: c.image || undefined,
}));
---

<BaseLayout>
  <Header />

  <Section id="news" title="News">
    <DatedList items={news} variant="news" empty="No news yet." />
  </Section>

  <Section id="publications" title="Publications">
    <Publications />
  </Section>

  {/* Projects 섹션은 2026-11-20 사용자 요청으로 뺐다. 데이터와 Projects.astro 는 남아 있다 */}

  <Section id="experience" title="Experience">
    <DatedList items={experience} variant="stacked" logoShape="wide" />
  </Section>

  <Section id="education" title="Education">
    <DatedList items={education} variant="stacked" logoShape="round" />
  </Section>

  <Section id="awards" title="Honors & Awards">
    <DatedList items={awards} />
    <h3 class="sub-title">Certificates</h3>
    <DatedList items={certificates} />
  </Section>

  <Section id="contact" title="Contact">
    <Contact />
  </Section>
</BaseLayout>

<style>
  .sub-title {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--text-muted);
    margin: 1.75rem 0 0.75rem;
  }
</style>
