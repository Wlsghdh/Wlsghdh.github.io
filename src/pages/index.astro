---
/**
 * 홈 — 섹션 순서만 정한다. 내용은 src/data/profile.json, src/data/log.json.
 * (skills 데이터는 profile.json 에 남아 있지만 화면에서는 뺐다)
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import DatedList from '../components/DatedList.astro';
import ResearchLog from '../components/ResearchLog.astro';
import Publications from '../components/Publications.astro';
import Projects from '../components/Projects.astro';
import { profile } from '../lib/data';

const news = profile.news.slice(0, 8).map((n: { date: string; text: string; link?: string }) => ({
  date: n.date,
  title: n.text,
  href: n.link,
}));
const experience = profile.experience.map((e) => ({ date: e.period, title: e.title, sub: e.org, detail: e.detail }));
const education = profile.education.map((e) => ({ date: e.period, title: e.school, sub: e.detail }));
const awards = profile.awards.map((a) => ({ date: a.date, title: a.title, sub: a.org, href: a.image || undefined }));
const certificates = profile.certificates.map((c) => ({
  date: c.date,
  title: c.title,
  sub: c.org,
  href: c.image || undefined,
}));
---

<BaseLayout>
  <Header />

  <Section id="news" title="News">
    <DatedList items={news} empty="No news yet." />
  </Section>

  <Section id="log" title="Research Log">
    <ResearchLog />
  </Section>

  <Section id="publications" title="Publications">
    <Publications />
  </Section>

  <Section id="projects" title="Projects">
    <Projects />
  </Section>

  <Section id="experience" title="Experience">
    <DatedList items={experience} variant="stacked" />
  </Section>

  <Section id="education" title="Education">
    <DatedList items={education} variant="stacked" />
  </Section>

  <Section id="awards" title="Honors & Awards">
    <DatedList items={awards} />
    <h3 class="sub-title">Certificates</h3>
    <DatedList items={certificates} />
  </Section>
</BaseLayout>

<style>
  .sub-title {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--text-muted);
    margin: 1.75rem 0 0.75rem;
  }
</style>
