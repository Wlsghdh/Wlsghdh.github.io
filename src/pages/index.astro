---
/**
 * 홈 — 섹션 순서만 정한다. 내용은 src/data/profile.json.
 * 화면에서 뺐지만 데이터는 남아 있는 것:
 *  - skills (profile.json)
 *  - Research Log (2026-11-17, log.json + ResearchLog.astro)
 *  - Projects (2026-11-20, profile.json projects + Projects.astro) — 다시 넣으려면 아래 주석의 섹션을 되살린다
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import DatedList from '../components/DatedList.astro';
import Publications from '../components/Publications.astro';
import { profile } from '../lib/data';
import { nb } from '../lib/text';

const news = profile.news.slice(0, 8).map((n: { date: string; text: string; link?: string }) => ({
  date: n.date,
  title: n.text,
  href: n.link,
}));
const experience = profile.experience.map((e) => ({ date: e.period, title: e.title, sub: e.org, detail: e.detail }));
const education = profile.education.map((e) => ({ date: e.period, title: e.school, sub: e.detail }));
const awards = profile.awards.map((a) => ({ date: a.date, title: a.title, sub: a.org, href: a.image || undefined }));
const certificates = profile.certificates.map((c) => ({
  date: c.date,
  title: c.title,
  sub: c.org,
  href: c.image || undefined,
}));
---

<BaseLayout>
  <Header />

  <Section id="about" title="About">
    <div class="about">
      {profile.person.intro.map((s: string) => <p>{nb(s)}</p>)}
    </div>
  </Section>

  <Section id="news" title="News">
    <DatedList items={news} variant="news" empty="No news yet." />
  </Section>

  <Section id="publications" title="Publications">
    <Publications />
  </Section>

  {/* <Section id="projects" title="Projects"><Projects /></Section>  (import Projects from '../components/Projects.astro') */}

  <Section id="experience" title="Experience">
    <DatedList items={experience} variant="stacked" />
  </Section>

  <Section id="education" title="Education">
    <DatedList items={education} variant="stacked" />
  </Section>

  <Section id="awards" title="Honors">
    <DatedList items={awards} />
    <h3 class="sub-title">Certificates</h3>
    <DatedList items={certificates} />
  </Section>
</BaseLayout>

<style>
  .about p + p {
    margin-top: 0.7rem;
  }
  .sub-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    margin: 1.75rem 0 0.7rem;
  }
</style>
