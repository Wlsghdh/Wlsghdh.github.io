---
/**
 * 홈 — 섹션 순서만 정한다. 내용은 src/data/profile.json, src/data/log.json.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import DatedList from '../components/DatedList.astro';
import ResearchLog from '../components/ResearchLog.astro';
import Publications from '../components/Publications.astro';
import Projects from '../components/Projects.astro';
import { profile } from '../lib/data';

const p = profile.person;
const news = profile.news.slice(0, 8).map((n: { date: string; text: string; link?: string }) => ({
  date: n.date,
  title: n.text,
  href: n.link,
}));
const experience = profile.experience.map((e) => ({ date: e.period, title: e.title, sub: e.org, detail: e.detail }));
const education = profile.education.map((e) => ({ date: e.period, title: e.school, detail: e.detail }));
const awards = profile.awards.map((a) => ({ date: a.date, title: a.title, sub: a.org, href: a.image || undefined }));
const certificates = profile.certificates.map((c) => ({
  date: c.date,
  title: c.title,
  sub: c.org,
  href: c.image || undefined,
}));
---

<BaseLayout>
  <Header />

  <Section id="news" title="News">
    <DatedList items={news} empty="소식이 아직 없습니다." />
  </Section>

  <Section id="log" title="Research Log">
    <ResearchLog />
  </Section>

  <Section id="publications" title="Publications">
    <Publications />
  </Section>

  <Section id="projects" title="Projects">
    <Projects />
  </Section>

  <Section id="experience" title="Experience">
    <DatedList items={experience} />
  </Section>

  <Section id="education" title="Education">
    <DatedList items={education} />
  </Section>

  <Section id="skills" title="Skills">
    <div class="rows">
      {
        profile.skills.map((s) => (
          <div class="row">
            <span class="row-date">{s.category}</span>
            <span class="small">{s.items.join(' · ')}</span>
          </div>
        ))
      }
    </div>
  </Section>

  <Section id="awards" title="Honors & Awards">
    <DatedList items={awards} />
    <h3 class="sub-title">Certificates</h3>
    <DatedList items={certificates} />
  </Section>

  <Section id="contact" title="Contact">
    <div class="rows">
      <div class="row"><span class="row-date">Email</span><a href={`mailto:${p.email}`}>{p.email}</a></div>
      <div class="row">
        <span class="row-date">GitHub</span>
        <a href={`https://github.com/${p.githubUsername}`} target="_blank" rel="noopener noreferrer"
          >github.com/{p.githubUsername}</a
        >
      </div>
      <div class="row">
        <span class="row-date">Blog</span>
        <a href={p.blog} target="_blank" rel="noopener noreferrer">{p.blog.replace(/^https?:\/\//, '')}</a>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .sub-title {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text-muted);
    margin: 1.6rem 0 0.6rem;
  }
</style>
