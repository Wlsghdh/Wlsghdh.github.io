---
/**
 * 날짜가 붙은 목록.
 * - variant="rows"    : 날짜(좌) + 한 줄(우)  — News, Honors, Certificates
 * - variant="stacked" : 날짜 → 제목 → 소속(이탤릭) → 설명, 항목 사이 얇은 선 — Experience, Education
 * href 가 있으면 제목이 그 파일(이미지/PDF)로 연결된다.
 */
interface Item {
  date: string;
  title: string;
  sub?: string;
  detail?: string;
  href?: string;
}
interface Props {
  items: Item[];
  variant?: 'rows' | 'stacked';
  empty?: string;
}
const { items, variant = 'rows', empty = 'Nothing here yet.' } = Astro.props;
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

{
  items.length === 0 ? (
    <p class="muted small">{empty}</p>
  ) : variant === 'stacked' ? (
    <div class="entries-lined">
      {items.map((it) => (
        <div class="stacked">
          <p class="s-date">{it.date}</p>
          <p class="s-title">{it.href ? <a href={it.href} {...ext}>{it.title}</a> : it.title}</p>
          {it.sub && <p class="s-sub">{it.sub}</p>}
          {it.detail && <p class="s-detail">{it.detail}</p>}
        </div>
      ))}
    </div>
  ) : (
    <div class="rows">
      {items.map((it) => (
        <div class="row">
          <span class="row-date">{it.date}</span>
          <div>
            <span>{it.href ? <a href={it.href} {...ext}>{it.title}</a> : it.title}</span>
            {it.sub && <span class="muted small r-sub">{it.sub}</span>}
            {it.detail && <p class="muted small">{it.detail}</p>}
          </div>
        </div>
      ))}
    </div>
  )
}

<style>
  .s-date {
    font-size: var(--fs-tiny);
    color: var(--text-muted);
  }
  .s-title {
    font-weight: 600;
    margin-top: 0.1rem;
  }
  .s-sub {
    font-size: var(--fs-small);
    font-style: italic;
    color: var(--text-muted);
  }
  .s-detail {
    font-size: var(--fs-small);
    margin-top: 0.2rem;
  }
  .r-sub {
    margin-left: 0.5rem;
  }
</style>
