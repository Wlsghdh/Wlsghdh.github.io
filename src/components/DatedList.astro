---
/**
 * 날짜가 붙은 목록.
 * - variant="rows"    : 날짜(좌) + 한 줄(우)  — News, Honors, Certificates
 * - variant="stacked" : 날짜 → 제목 → 소속(이탤릭) → 설명, 항목 사이 얇은 선 — Experience, Education
 * href 가 있으면 제목이 그 파일(이미지/PDF)로 연결된다.
 */
interface Item {
  date: string;
  title: string;
  sub?: string;
  detail?: string;
  href?: string;
  /** stacked 에서만: 왼쪽 로고 이미지 */
  logo?: string;
  /** stacked 에서만: 설명 대신 보이는 키워드 하나 */
  keyword?: string;
}
interface Props {
  items: Item[];
  variant?: 'rows' | 'stacked' | 'news';
  empty?: string;
  /** 로고 칸 모양 — wide: 가로로 긴 네모(Experience), round: 동그라미(Education) */
  logoShape?: 'wide' | 'round';
}
import { nb } from '../lib/text';
const { items: raw, variant = 'rows', empty = 'Nothing here yet.', logoShape = 'wide' } = Astro.props;
const items = raw.map((it) => ({ ...it, title: nb(it.title), sub: it.sub && nb(it.sub), detail: it.detail && nb(it.detail) }));
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

{
  items.length === 0 ? (
    <p class="muted small">{empty}</p>
  ) : variant === 'news' ? (
    <ul class="news-list">
      {items.map((it) => (
        <li>
          <span class="news-date">{it.date}</span>
          <span>{it.href ? <a href={it.href} {...ext}>{it.title}</a> : it.title}</span>
        </li>
      ))}
    </ul>
  ) : variant === 'stacked' ? (
    <div class="entries-lined">
      {items.map((it) => (
        <div class:list={['stacked', it.logo && 'has-logo']}>
          {it.logo && (
            <span class:list={['logo', `logo-${logoShape}`]}>
              <img src={it.logo} alt="" loading="lazy" />
            </span>
          )}
          <div>
            <p class="s-date">{it.date}</p>
            <p class="s-title">{it.href ? <a href={it.href} {...ext}>{it.title}</a> : it.title}</p>
            {it.sub && <p class="s-sub">{it.sub}</p>}
            {it.detail && <p class="s-detail">{it.detail}</p>}
            {it.keyword && <span class="s-keyword">{it.keyword}</span>}
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="rows">
      {items.map((it) => (
        <div class="row">
          <span class="row-date">{it.date}</span>
          <div>
            <span>{it.href ? <a href={it.href} {...ext}>{it.title}</a> : it.title}</span>
            {it.sub && <span class="muted small r-sub">{it.sub}</span>}
            {it.detail && <p class="muted small">{it.detail}</p>}
          </div>
        </div>
      ))}
    </div>
  )
}

<style>
  .s-date {
    font-size: var(--fs-tiny);
    color: var(--text-muted);
  }
  .s-title {
    font-weight: 600;
    margin-top: 0.1rem;
  }
  .s-sub {
    font-size: var(--fs-small);
    font-style: italic;
    color: var(--text-muted);
  }
  .s-detail {
    font-size: var(--fs-small);
    margin-top: 0.2rem;
  }
  .r-sub {
    margin-left: 0.5rem;
  }
  .s-keyword {
    display: inline-block;
    margin-top: 0.35rem;
    padding: 0.05rem 0.55rem;
    border-radius: 999px;
    background: var(--ink-soft);
    color: var(--text);
    font-size: var(--fs-tiny);
    font-weight: 500;
  }
  .has-logo {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
  }
  .logo {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .logo-wide {
    width: 132px;
    height: 56px;
    padding: 8px 12px;
    border-radius: 6px;
  }
  .logo-round {
    width: 64px;
    height: 64px;
    padding: 6px;
    border-radius: 50%;
  }
  @media (max-width: 600px) {
    .logo-wide {
      width: 92px;
      height: 42px;
      padding: 6px 8px;
    }
    .logo-round {
      width: 48px;
      height: 48px;
      padding: 4px;
    }
  }
</style>
