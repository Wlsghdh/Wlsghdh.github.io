---
import { profile } from '../lib/data';
import { navSections } from '../data/site';

const p = profile.person;
const links = [
  { label: 'Email', url: `mailto:${p.email}` },
  { label: 'CV', url: p.cv },
  { label: 'GitHub', url: `https://github.com/${p.githubUsername}` },
  { label: 'Google Scholar', url: p.scholar },
  { label: 'Blog', url: p.blog },
].filter((l) => l.url);
---

<header class="header">
  <img
    class="photo"
    src={p.photo}
    alt={p.nameKo}
    width="120"
    onerror="this.onerror=null;this.src='/profile-placeholder.svg'"
  />
  <div class="desc">
    <h1>{p.nameKo}<span class="en">{p.nameEn}</span></h1>
    {p.headline && <p class="headline">{p.headline}</p>}
    {p.intro.map((s: string) => <p class="intro">{s}</p>)}
    <p class="links">
      {
        links.map((l, i) => (
          <>
            {i > 0 && <span class="sep">/</span>}
            <a href={l.url} {...(l.url.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              {l.label}
            </a>
          </>
        ))
      }
    </p>
  </div>
</header>

<nav class="nav" aria-label="섹션">
  {navSections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
</nav>

<style>
  .header {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    padding: 4.5rem 0 2rem;
  }
  .photo {
    flex: 0 0 120px;
    width: 120px;
    height: auto;
    display: block;
  }
  .desc {
    min-width: 0;
    padding-top: 0.25rem;
  }
  h1 {
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .en {
    margin-left: 0.6rem;
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--text-muted);
  }
  .headline {
    color: var(--text-muted);
    margin: 0.3rem 0 0;
  }
  .intro {
    margin-top: 0.5rem;
  }
  .links {
    margin-top: 1rem;
    font-size: var(--fs-small);
  }
  .sep {
    color: var(--line);
    margin: 0 0.5rem;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
    font-size: var(--fs-tiny);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .nav a {
    color: var(--text-muted);
  }
  .nav a:hover {
    color: var(--text);
    text-decoration: none;
  }

  @media (max-width: 560px) {
    .header {
      flex-direction: column;
      gap: 1.1rem;
      padding-top: 3rem;
    }
    .photo {
      width: 100px;
      flex-basis: auto;
    }
  }
</style>
