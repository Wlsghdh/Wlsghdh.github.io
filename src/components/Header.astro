---
/**
 * 헤더 — Jon Barron 계열: 왼쪽(이름 가운데 정렬, 소속, 소개, 링크 "Email / GitHub / Blog"), 오른쪽 정사각 사진.
 * (person.keywords 는 데이터에만 남아 있고 화면에서는 뺐다)
 */
import { profile } from '../lib/data';
import { nb } from '../lib/text';

const p = profile.person;
const links = [
  { label: 'Email', url: `mailto:${p.email}` },
  { label: 'CV', url: p.cv },
  { label: 'GitHub', url: `https://github.com/${p.githubUsername}` },
  { label: 'Google Scholar', url: p.scholar },
  { label: 'Blog', url: p.blog },
].filter((l) => l.url);
---

<header class="header">
  <div class="desc">
    <h1 class="name">{p.nameEn}</h1>
    {
      p.headline && (
        <p class="headline">
          {p.headline.split(' · ').map((part: string, i: number, arr: string[]) => (
            <>
              <span class="nowrap">
                {nb(part)}
                {i < arr.length - 1 && <span class="dot"> ·</span>}
              </span>{' '}
            </>
          ))}
        </p>
      )
    }
    <div class="bio">
      {p.intro.map((s: string) => <p>{nb(s)}</p>)}
    </div>
    <p class="links">
      {
        links.map((l, i) => (
          <>
            {i > 0 && <span class="sep">/</span>}
            <a href={l.url} {...(l.url.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              {l.label}
            </a>
          </>
        ))
      }
    </p>
  </div>
  <img class="photo" src={p.photo} alt={p.nameEn} onerror="this.onerror=null;this.src='/profile-placeholder.svg'" />
</header>

<style>
  .header {
    display: grid;
    grid-template-columns: minmax(0, 63fr) minmax(0, 37fr);
    gap: 2.5rem;
    align-items: center;
    padding: 2.5rem 16px 1rem;
  }
  .name {
    text-align: center;
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .headline {
    text-align: center;
    margin-top: 0.45rem;
    font-size: 13.5px;
    color: var(--text-muted);
    text-wrap: balance;
  }
  .nowrap {
    white-space: nowrap;
  }
  .dot {
    color: var(--accent);
  }
  .bio {
    margin-top: 1.25rem;
  }
  .bio p + p {
    margin-top: 0.7rem;
  }
  .links {
    text-align: center;
    margin-top: 1.1rem;
  }
  .sep {
    color: var(--text-muted);
    margin: 0 0.6rem;
  }
  .photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center 25%;
    display: block;
  }

  @media (max-width: 640px) {
    .header {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
      padding: 2rem 0 0.5rem;
    }
    .photo {
      grid-row: 1;
      width: 160px;
      margin: 0 auto;
    }
  }
</style>
