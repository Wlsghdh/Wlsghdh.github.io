---
/**
 * 헤더 — 왼쪽 칸(섹션 이름 칸과 같은 폭)에 사진, 오른쪽에 이름 · 소속 · 링크.
 * 소개 문단(person.intro)은 index.astro 의 About 섹션에서 보여준다.
 */
import { profile } from '../lib/data';
import { nb } from '../lib/text';

const p = profile.person;
const links = [
  { label: 'Email', url: `mailto:${p.email}` },
  { label: 'CV', url: p.cv },
  { label: 'GitHub', url: `https://github.com/${p.githubUsername}` },
  { label: 'Google Scholar', url: p.scholar },
  { label: 'Blog', url: p.blog },
].filter((l) => l.url);
---

<header class="header">
  <img class="photo" src={p.photo} alt={p.nameEn} onerror="this.onerror=null;this.src='/profile-placeholder.svg'" />
  <div>
    <h1 class="name">{p.nameEn}</h1>
    {
      p.headline && (
        <p class="headline">
          {p.headline.split(' · ').map((part: string, i: number, arr: string[]) => (
            <>
              <span class="nowrap">
                {nb(part)}
                {i < arr.length - 1 && <span class="dot"> ·</span>}
              </span>{' '}
            </>
          ))}
        </p>
      )
    }
    <p class="links">
      {
        links.map((l) => (
          <a href={l.url} {...(l.url.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
            {l.label}
          </a>
        ))
      }
    </p>
  </div>
</header>

<style>
  .header {
    display: grid;
    grid-template-columns: var(--label-w) minmax(0, 1fr);
    column-gap: var(--col-gap);
    align-items: center;
    padding: 3.5rem 0 2.5rem;
  }
  .photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center 22%;
    border-radius: 12px;
    display: block;
  }
  .name {
    font-size: 32px;
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .headline {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .nowrap {
    white-space: nowrap;
  }
  .dot {
    color: #b6c2cf;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    margin-top: 0.9rem;
    font-size: var(--fs-small);
    font-weight: 500;
  }
  .links a::after {
    content: ' ↗';
    font-size: 0.85em;
    opacity: 0.6;
  }

  @media (max-width: 640px) {
    .header {
      grid-template-columns: 72px minmax(0, 1fr);
      column-gap: 1rem;
      padding: 2.25rem 0 1.75rem;
    }
    .name {
      font-size: 26px;
    }
    .headline {
      font-size: 12.5px;
    }
  }
</style>
