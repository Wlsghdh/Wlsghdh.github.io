---
/**
 * Contact: 가상 명함 한 장 (참고: fid-design.github.io/Interior 의 CONTACT 명함).
 * 앞면만 있다: 이름, 직함, 연락처, 로봇 아이콘. 평소엔 살짝 기울어 있고 마우스를 올리면 똑바로 선다.
 * 뒷면, 소속 표기, 사진, 안내 문구, 그림자는 넣지 않는다 (2026-11-23 사용자 지시).
 * 글자 크기는 카드 폭(cqw)에 비례하고, 모바일에서 너무 작아지지 않게 최소 px 를 둔다.
 */
import { profile } from '../lib/data';

const p = profile.person;
const github = `github.com/${p.githubUsername}`;
const blogHost = p.blog.replace(/^https?:\/\//, '').replace(/\/$/, '');
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<div class="cardwrap">
  <figure class="bizcard" aria-label={`${p.nameEn} business card`}>
    <div class="body">
    <svg class="robot" viewBox="0 0 64 64" aria-hidden="true">
      <line x1="32" y1="6" x2="32" y2="14" />
      <circle cx="32" cy="5" r="2.6" class="acc-fill" />
      <rect x="14" y="14" width="36" height="26" rx="7" />
      <circle cx="25" cy="27" r="3.4" class="acc-fill" />
      <circle cx="39" cy="27" r="3.4" class="acc-fill" />
      <line x1="9" y1="24" x2="9" y2="31" />
      <line x1="55" y1="24" x2="55" y2="31" />
      <path d="M20 40 v6 a4 4 0 0 0 4 4 h16 a4 4 0 0 0 4 -4 v-6" />
      <line x1="24" y1="50" x2="24" y2="58" />
      <line x1="40" y1="50" x2="40" y2="58" />
      <line x1="19" y1="58" x2="29" y2="58" />
      <line x1="35" y1="58" x2="45" y2="58" />
    </svg>
    <div class="who">
      <p class="name">{p.nameEn}</p>
      <p class="role">Undergraduate Researcher · LLM / VLA</p>
    </div>
    <ul class="info">
      {p.phone && <li><b>M.</b><a href={`tel:${p.phone.replace(/\D/g, '')}`}>{p.phone}</a></li>}
      <li><b>E.</b><a href={`mailto:${p.email}`}>{p.email}</a></li>
      <li><b>G.</b><a href={`https://${github}`} {...ext}>{github}</a></li>
      <li><b>B.</b><a href={p.blog} {...ext}>{blogHost}</a></li>
    </ul>
    </div>
  </figure>
</div>

<style>
  .cardwrap {
    display: flex;
    justify-content: center;
    padding: 0.75rem 0 0.5rem;
  }
  .bizcard {
    container-type: inline-size;
    position: relative;
    width: min(100%, 460px);
    aspect-ratio: 1.75 / 1;
    margin: 0;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    color: var(--text);
    transform: rotate(-2deg);
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* cqw 는 자기 자신이 아니라 바깥 컨테이너 기준이라, 안쪽 여백은 .body 에 준다 */
  .body {
    position: absolute;
    inset: 0;
    padding: 6.5cqw 7cqw 6cqw;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .bizcard:hover,
  .bizcard:focus-within {
    transform: rotate(0deg);
  }
  .robot {
    position: absolute;
    top: 7cqw;
    right: 7.5cqw;
    width: 15cqw;
    height: 15cqw;
    fill: none;
    stroke: var(--text);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .robot .acc-fill {
    fill: var(--accent);
    stroke: none;
  }
  .who {
    width: 62%;
    padding-bottom: 2cqw;
    border-bottom: 1px solid var(--text);
  }
  .name {
    font-size: max(6cqw, 21px);
    font-weight: 700;
    line-height: 1.15;
  }
  .role {
    font-size: max(2.9cqw, 12px);
    color: var(--text-muted);
    margin-top: 0.6cqw;
    white-space: nowrap;
  }
  .info {
    list-style: none;
    margin: 2.6cqw 0 0;
    padding: 0;
    font-size: max(3.1cqw, 12.5px);
    line-height: 1.6;
  }
  .info li {
    white-space: nowrap;
  }
  .info b {
    display: inline-block;
    width: max(5.8cqw, 25px);
    color: var(--accent);
    font-weight: 700;
  }
  .info a {
    color: var(--text);
  }
  .info a:hover {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .bizcard {
      transition: none;
    }
  }
</style>
