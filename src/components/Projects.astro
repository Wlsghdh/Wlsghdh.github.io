---
/** Projects — Publications 와 같은 구성: 썸네일 + 제목 / 기간 · 설명 / 요약 / 스택 / 링크 */
import { profile } from '../lib/data';
const projects = profile.projects;
const PLACEHOLDER = '/assets/thumb-placeholder.svg';
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<div class="entries">
  {
    projects.map((p) => (
      <article class="entry">
        <img
          class="entry-thumb"
          src={p.image || PLACEHOLDER}
          alt=""
          loading="lazy"
          onerror={`this.onerror=null;this.src='${PLACEHOLDER}'`}
        />
        <div>
          <p class="entry-title">{p.title}</p>
          <p class="entry-meta">
            <span class="venue">{p.period}</span>
            {p.subtitle && <span> · {p.subtitle}</span>}
          </p>
          <p class="entry-summary">{p.summary}</p>
          <p class="entry-stack">{p.stack.join(' · ')}</p>
          {p.links.length > 0 && (
            <p class="entry-links">
              {p.links.map((l) => (
                <a href={l.url} {...ext}>
                  {l.label}
                </a>
              ))}
            </p>
          )}
        </div>
      </article>
    ))
  }
</div>
