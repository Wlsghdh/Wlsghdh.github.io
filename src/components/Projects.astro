---
import { profile } from '../lib/data';
const projects = profile.projects;
const PLACEHOLDER = '/assets/thumb-placeholder.svg';
---

<div>
  {
    projects.map((p) => (
      <article class="media">
        <img
          class="thumb-img"
          src={p.image || PLACEHOLDER}
          alt=""
          loading="lazy"
          onerror={`this.onerror=null;this.src='${PLACEHOLDER}'`}
        />
        <div>
          <p class="media-title">{p.title}</p>
          <p class="media-meta">
            {p.period}
            {p.subtitle && <span> · {p.subtitle}</span>}
          </p>
          <p class="media-body">{p.summary}</p>
          <p class="stack">{p.stack.join(' · ')}</p>
          {p.links.length > 0 && (
            <p class="chips">
              {p.links.map((l) => <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>)}
            </p>
          )}
        </div>
      </article>
    ))
  }
</div>

<style>
  .stack {
    color: var(--text-muted);
    font-size: var(--fs-tiny);
    margin-top: 0.3rem;
  }
</style>
