---
import { profile } from '../lib/data';
const projects = profile.projects;
const PLACEHOLDER = '/assets/thumb-placeholder.svg';
---

<div class="list">
  {
    projects.map((p) => (
      <article class="proj">
        <img
          class="thumb-img"
          src={p.image || PLACEHOLDER}
          alt=""
          loading="lazy"
          onerror={`this.onerror=null;this.src='${PLACEHOLDER}'`}
        />
        <div>
          <p class="head">
            <span class="title">{p.title}</span>
            <span class="period">{p.period}</span>
          </p>
          {p.subtitle && <p class="muted small">{p.subtitle}</p>}
          <p class="summary">{p.summary}</p>
          <p class="stack">{p.stack.join(' · ')}</p>
          {p.links.length > 0 && (
            <p class="chips">
              {p.links.map((l) => <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>)}
            </p>
          )}
        </div>
      </article>
    ))
  }
</div>

<style>
  .proj {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  .proj + .proj {
    margin-top: 1.5rem;
  }
  .head {
    display: flex;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    flex-wrap: wrap;
  }
  .title {
    font-weight: 500;
  }
  .period {
    color: var(--text-muted);
    font-size: var(--fs-small);
    white-space: nowrap;
  }
  .summary {
    font-size: var(--fs-small);
    margin-top: 0.2rem;
  }
  .stack {
    color: var(--text-muted);
    font-size: var(--fs-tiny);
    margin-top: 0.15rem;
  }
  @media (max-width: 560px) {
    .proj {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6rem;
    }
    .proj .thumb-img {
      max-width: 240px;
    }
  }
</style>
