---
import { profile, type Publication } from '../lib/data';

const me = profile.person.nameEn;
/** hidden: true 인 항목은 데이터에만 남기고 화면에서 뺀다 */
const pubs = profile.publications.filter((p) => !(p as { hidden?: boolean }).hidden);
const PLACEHOLDER = '/assets/thumb-placeholder.svg';

const linksOf = (p: Publication) => [...(p.pdf ? [{ label: 'PDF', url: p.pdf }] : []), ...p.links];
---

<div>
  {
    pubs.map((p) => (
      <article class="media">
        <a class="thumb" href={p.pdf || undefined} target="_blank" rel="noopener noreferrer">
          <img
            class="thumb-img"
            src={p.thumb || PLACEHOLDER}
            alt=""
            loading="lazy"
            onerror={`this.onerror=null;this.src='${PLACEHOLDER}'`}
          />
        </a>
        <div>
          <p class="media-title">
            {p.pdf ? (
              <a href={p.pdf} target="_blank" rel="noopener noreferrer">
                {p.title}
              </a>
            ) : (
              p.title
            )}
          </p>
          <p class="authors">
            {p.authors.map((a, i) => (
              <>
                {i > 0 && ', '}
                {a === me ? <b>{a}</b> : a}
                {(p.coFirst as string[]).includes(a) && '*'}
              </>
            ))}
          </p>
          <p class="media-meta">
            <span class="venue">{p.venue}</span>
            {p.note && <span> · {p.note}</span>}
          </p>
          {p.summary && <p class="media-body">{p.summary}</p>}
          {linksOf(p).length > 0 && (
            <p class="chips">
              {linksOf(p).map((l) => <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>)}
            </p>
          )}
        </div>
      </article>
    ))
  }
</div>
{pubs.some((p) => p.coFirst.length > 0) && <p class="muted small note">* Equal contribution</p>}

<style>
  .authors {
    font-size: var(--fs-small);
    margin-top: 0.15rem;
  }
  .authors b {
    font-weight: 600;
  }
  .venue {
    font-style: normal;
    font-weight: 600;
    color: var(--accent);
  }
  .note {
    margin-top: 1rem;
  }
</style>
