---
/** Publications — 왼쪽 175px 썸네일, 제목(굵게) / 저자(내 이름 굵게+밑줄) / 학회(이탤릭) / TL;DR / 링크 "PDF / arXiv / Code" */
import { profile, type Publication } from '../lib/data';
import { nb } from '../lib/text';

const me = profile.person.nameEn;
/** hidden: true 인 항목은 데이터에만 남기고 화면에서 뺀다 */
const pubs = profile.publications.filter((p) => !(p as { hidden?: boolean }).hidden);
const PLACEHOLDER = '/assets/thumb-placeholder.svg';
const ext = { target: '_blank', rel: 'noopener noreferrer' };

const linksOf = (p: Publication) => [...(p.pdf ? [{ label: 'PDF', url: p.pdf }] : []), ...p.links];
---

<div>
  {
    pubs.map((p) => (
      <article class="pub">
        <img
          class="pub-thumb"
          src={p.thumb || PLACEHOLDER}
          alt=""
          loading="lazy"
          onerror={`this.onerror=null;this.src='${PLACEHOLDER}'`}
        />
        <div>
          <p class="pub-title">
            {p.pdf ? (
              <a href={p.pdf} {...ext}>
                {p.title}
              </a>
            ) : (
              p.title
            )}
          </p>
          <p class="pub-line">
            {p.authors.map((a, i) => (
              <>
                {i > 0 && ', '}
                {a === me ? <b class="me">{nb(a)}</b> : nb(a)}
                {(p.coFirst as string[]).includes(a) && '*'}
              </>
            ))}
          </p>
          <p class="pub-line">
            <em>{p.venue}</em>{p.note && <span class="muted">, {p.note}</span>}
            {(p as { award?: string }).award && (
              <span class="award">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M7 4h10v4a5 5 0 0 1-10 0V4Z" />
                  <path d="M7 6H4v1a3 3 0 0 0 3 3M17 6h3v1a3 3 0 0 1-3 3" />
                  <path d="M12 13v4M8.5 20h7M9.5 17h5v3h-5z" />
                </svg>
                {(p as { award?: string }).award}
              </span>
            )}
          </p>
          {/* summary(TL;DR)는 2026-11-23 사용자 요청으로 화면에서 뺐다. 데이터는 남아 있다 */}
          {linksOf(p).length > 0 && (
            <p class="pub-links">
              {linksOf(p).map((l, i) => (
                <>
                  {i > 0 && ' / '}
                  <a href={l.url} {...ext}>
                    {l.label}
                  </a>
                </>
              ))}
            </p>
          )}
        </div>
      </article>
    ))
  }
</div>
{pubs.some((p) => p.coFirst.length > 0) && <p class="muted small note">* Equal contribution</p>}

<style>
  .me {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .note {
    margin-top: 1rem;
  }
  /* 수상 배지: profile.json publications 의 award 필드가 있으면 학회 줄 옆에 붙는다 */
  .award {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: 8px;
    padding: 1px 9px 1px 7px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    vertical-align: 1px;
    white-space: nowrap;
  }
  .award svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
