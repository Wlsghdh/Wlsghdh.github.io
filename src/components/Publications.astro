---
import { profile, type Publication } from '../lib/data';

const me = profile.person.nameKo;
const pubs = profile.publications;
const years = [...new Set(pubs.map((p) => p.year))].sort((a, b) => b - a);

const linksOf = (p: Publication) => [
  ...(p.pdf ? [{ label: 'PDF', url: p.pdf }] : []),
  ...p.links,
];
---

{
  years.map((y) => (
    <div class="year-group">
      <h3 class="year">{y}</h3>
      {pubs
        .filter((p) => p.year === y)
        .map((p) => (
          <article class:list={['pub', { 'has-thumb': !!p.thumb }]}>
            {p.thumb && (
              <a class="thumb" href={p.pdf || undefined} target="_blank" rel="noopener noreferrer">
                <img src={p.thumb} alt="" loading="lazy" />
              </a>
            )}
            <div class="body">
              <p class="title">
                {p.pdf ? (
                  <a href={p.pdf} target="_blank" rel="noopener noreferrer">
                    {p.title}
                  </a>
                ) : (
                  p.title
                )}
              </p>
              <p class="authors">
                {p.authors.map((a, i) => (
                  <>
                    {i > 0 && ', '}
                    {a === me ? <b>{a}</b> : a}
                    {(p.coFirst as string[]).includes(a) && '*'}
                  </>
                ))}
              </p>
              <p class="venue">
                <i>{p.venue}</i>
                {p.note && <span class="note"> · {p.note}</span>}
              </p>
              {p.summary && <p class="summary">{p.summary}</p>}
              {linksOf(p).length > 0 && (
                <p class="chips">
                  {linksOf(p).map((l) => (
                    <a href={l.url} target="_blank" rel="noopener noreferrer">
                      {l.label}
                    </a>
                  ))}
                </p>
              )}
            </div>
          </article>
        ))}
    </div>
  ))
}
{pubs.some((p) => p.coFirst.length > 0) && <p class="muted small">* 공동 1저자</p>}

<style>
  .year-group + .year-group {
    margin-top: 1.5rem;
  }
  .year {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }
  .pub {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }
  .pub + .pub {
    margin-top: 1.1rem;
  }
  .pub.has-thumb {
    grid-template-columns: 160px minmax(0, 1fr);
  }
  .thumb img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 1px solid var(--line);
    display: block;
  }
  .title {
    font-weight: 500;
    line-height: 1.45;
  }
  .title a {
    color: var(--text);
  }
  .title a:hover {
    color: var(--accent);
  }
  .authors,
  .venue {
    font-size: var(--fs-small);
  }
  .authors b {
    font-weight: 600;
  }
  .venue,
  .note,
  .summary {
    color: var(--text-muted);
  }
  .summary {
    font-size: var(--fs-small);
    margin-top: 0.2rem;
  }
  @media (max-width: 560px) {
    .pub.has-thumb {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6rem;
    }
    .thumb {
      max-width: 240px;
    }
  }
</style>
