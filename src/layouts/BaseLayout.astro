---
import '../styles/global.css';
import { profile, todayKST } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
}

const p = profile.person;
const { title, description = profile.site.description } = Astro.props;
const pageTitle = title ? `${title} · ${p.nameKo}` : `${p.nameKo} ${p.nameEn}`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <main class="container">
      <slot />
    </main>
    <footer class="container footer">
      <span>© {p.nameKo} · {p.nameEn}</span>
      <span>Last updated {todayKST()}</span>
    </footer>
  </body>
</html>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    color: var(--text-muted);
    font-size: var(--fs-tiny);
    padding-top: 1.25rem;
    padding-bottom: 3rem;
  }
  .footer::before {
    content: '';
    flex-basis: 100%;
    border-top: 1px solid var(--line);
    margin-bottom: 0.75rem;
  }
</style>
